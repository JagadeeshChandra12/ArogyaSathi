# Copy this file to .env and fill in real values. Never commit .env.

# Gemini (optional — for medical chat / analysis on server)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Firebase web app (Vite) — Firebase Console → Project settings
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Google Sign-In (optional) — OAuth 2.0 Web client ID
# VITE_GOOGLE_WEB_CLIENT_ID=

# Health Record Companion (optional)
# VITE_CLOUD_REPORT_UPLOAD_URL=
# VITE_HEALTH_RECORD_COMPANION_URL=

# API URLs (optional — for health passport API from frontend)
# VITE_API_BASE_URL=http://localhost:3001

# AWS S3 (optional — for summary PDF storage on server)
# AWS_REGION=
# AWS_S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# PUBLIC_BASE_URL=http://localhost:5173
# API_BASE_URL=http://localhost:3001
